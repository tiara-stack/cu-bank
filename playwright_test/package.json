{
  "name": "playwright_test",
  "version": "1.0.0",
  "private": true,
  "description": "CU Bank frontend end-to-end tests",
  "type": "module",
  "scripts": {
    "format": "vp fmt . --write",
    "format:check": "vp fmt . --check",
    "test": "playwright test",
    "test:demo": "playwright test --grep @demo",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:list": "playwright test --list",
    "report": "playwright show-report",
    "browsers:install": "playwright install chromium",
    "typecheck": "tsc --noEmit",
    "lint": "fallow dead-code",
    "check": "npm run format:check && npm run typecheck && npm run lint"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@types/node": "24.19.2",
    "fallow": "3.42.0",
    "mongodb": "6.22.0",
    "mongodb-memory-server": "11.3.0",
    "typescript": "5.9.3",
    "vite-plus": "1.6.0"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  }
}
